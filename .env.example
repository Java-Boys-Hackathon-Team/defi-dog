# Скопируй в .env рядом с docker-compose.yml и подставь значения.
# Любой ключ можно оставить заглушкой: приложение поднимется, не работать будут
# только обращения к соответствующему сервису.

ALCHEMY_API_KEY=<Alchemy API key - https://docs.alchemy.com/docs/alchemy-quickstart-guide>
ETHERSCAN_API_KEY=<Etherscan API key - https://docs.etherscan.io/etherscan-v2/getting-started/getting-an-api-key>
OPENAI_API_KEY=<ключ OpenAI>
DEFI_DOG_TELEGRAM_BOT_TOKEN=<токен Telegram-бота>
COINMARKETCAP_API_KEY=<CoinMarketCap API key - https://coinmarketcap.com/api/documentation/v1/>
DEDAUB_API_KEY=<Dedaub API key - https://app.dedaub.com/profile>
MAIL_KEY=<пароль приложения для SMTP Gmail>
